{
  "data": {
    "input_path": "data/retail_store_inventory.csv",
    "output_dir": "output",
    "validation": {
      "min_date_range_days": 30,
      "max_missing_pct": 0.1,
      "required_columns": [
        "Date",
        "Store ID",
        "Product ID",
        "Category",
        "Region",
        "Inventory Level",
        "Units Sold",
        "Units Ordered",
        "Demand Forecast",
        "Price",
        "Discount",
        "Weather Condition",
        "Holiday/Promotion",
        "Competitor Pricing",
        "Seasonality"
      ]
    }
  },
  "model": {
    "base_model_type": "xgb",
    "min_cluster_size": 100,
    "n_estimators": 100,
    "max_depth": 10,
    "learning_rate": 0.1,
    "random_state": 42
  },
  "inventory": {
    "lead_time_days": 7,
    "service_level": 0.95,
    "holding_cost_rate": 0.25,
    "ordering_cost": 50.0,
    "stockout_cost": 100.0,
    "min_reorder_point": 0,
    "max_order_quantity": 10000
  },
  "pricing": {
    "min_margin": 0.2,
    "competitor_weight": 0.3,
    "max_discount": 0.3,
    "price_elasticity_window": 90,
    "min_price_multiplier": 0.7,
    "max_price_multiplier": 1.3
  },
  "dashboard": {
    "refresh_interval": 3600,
    "max_points": 10000,
    "cache_timeout": 300,
    "port": 8051,
    "debug": false
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "logs/inventory_management.log",
    "max_bytes": 10485760,
    "backup_count": 5
  }
} 